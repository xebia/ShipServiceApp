@model IEnumerable<ShipServicesApp.Models.UnderwaterService>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-primary text-white mb-3">
            <div class="card-body">
                <h5>Completed</h5>
                <div style="font-size:2rem;">@Model.Count(x => x.Status=="Completed")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-info text-white mb-3">
            <div class="card-body">
                <h5>Scheduled</h5>
                <div style="font-size:2rem;">@Model.Count(x => x.Status=="Scheduled")</div>
            </div>
        </div>
    </div>
</div>
<h2 class="mb-4">Underwater/Diving Services</h2>
