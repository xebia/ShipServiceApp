    <!-- Response Format Section -->
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-light">
            <h4 class="mb-0 text-primary">
                <i class="bi bi-braces"></i> Response Format
            </h4>
        </div>
        <div class="card-body">
            <p>All API endpoints return data in JSON format. Example response structure:</p>
            <pre class="bg-light p-3 rounded"><code>[
  {
    "id": 1,
    "agencyName": "Blue Ocean Maritime",
    "contactPerson": "Alice Dsouza",
    "contactEmail": "alice@blueocean.com"
  },
  {
    "id": 2,
    "agencyName": "Global Ports",
    "contactPerson": "John Lee",
    "contactEmail": "john@globalports.com"
  }
]</code></pre>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card mb-4 shadow-sm border-success">
        <div class="card-header bg-light">
            <h4 class="mb-0 text-success">
                <i class="bi bi-link-45deg"></i> Quick Links
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="/swagger" class="btn btn-outline-primary btn-sm">
