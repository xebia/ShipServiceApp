@model IEnumerable<ShipServicesApp.Models.ShipAgency>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ship Agencies</h2>
    <a href="#" class="btn btn-primary shadow">+ Add New Agency</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
@foreach(var agency in Model)
{
    <div class="col">
        <div class="card shadow-sm h-100 border-0">
            <div class="row g-0 align-items-center">
                <div class="col-auto px-2 pt-2">
                    <img src="https://ui-avatars.com/api/?name=@agency.AgencyName&background=random&size=64" class="rounded-circle" alt="Avatar" width="64">
                </div>
                <div class="col">
                    <div class="card-body">
                        <h5 class="card-title">@agency.AgencyName</h5>
                        <p class="mb-1"><i class="bi bi-person-fill"></i> @agency.ContactPerson</p>
                        <p class="mb-0 text-muted"><i class="bi bi-envelope"></i> @agency.ContactEmail</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">