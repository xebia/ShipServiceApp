@model IEnumerable<ShipServicesApp.Models.HusbandingRequest>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-success text-white mb-3">
            <div class="card-body">
                <h5>Delivered</h5>
                <div style="font-size:2rem;">@Model.Count(x => x.Status=="Delivered")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-warning text-dark mb-3">
            <div class="card-body">
                <h5>Pending</h5>
                <div style="font-size:2rem;">@Model.Count(x => x.Status=="Pending")</div>
            </div>
        </div>
    </div>
</div>
<h2 class="mb-4">Husbanding Requests</h2>
